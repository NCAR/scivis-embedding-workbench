# Copy this file to casper-marimo.env and fill in YOUR values.
# Lines marked "REQUIRED" must be edited before the launcher will run.
# Everything else has sensible NCAR-Casper defaults; you'll still be prompted
# at run time and can press Enter to accept them.

# ─── REQUIRED: personal values ──────────────────────────────────────────────
# Your NCAR project allocation code (passed to PBS as `-A`).
PBS_ACCOUNT=<YOUR_PROJECT_CODE>

# Absolute path to this repo on Casper (where `uv run marimo edit` is invoked).
# Example: /glade/work/<your_user>/scivis-embedding-workbench
REMOTE_PROJECT_DIR=<ABSOLUTE_PATH_TO_REPO_ON_CASPER>

# Your NCAR username (used in `ssh <user>@casper.hpc.ucar.edu`).
GATEWAY_USER=<YOUR_NCAR_USERNAME>

# ─── Defaults (safe to leave; you'll be prompted to override per run) ───────
PBS_QUEUE=casper
GATEWAY_HOST=casper.hpc.ucar.edu

DEFAULT_GPU_TYPE=v100
DEFAULT_NGPUS=1
DEFAULT_NCPUS=32
DEFAULT_MEM=120GB
DEFAULT_WALLTIME=06:00:00

LOCAL_PORT=2718
REMOTE_PORT=2718
